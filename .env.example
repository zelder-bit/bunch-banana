# Copy to .env and fill in. .env is git-ignored: real values never go in the repo.
# Generate secrets with:  openssl rand -hex 32

# ---- Network -------------------------------------------------------------
# Which host address the ports listen on. 127.0.0.1 = this machine only.
# Set to this server's LAN address (or 0.0.0.0) so your other machines can reach it.
# Do NOT port-forward these to the internet; use a VPN (e.g. WireGuard/Tailscale) for remote access.
BIND_ADDR=127.0.0.1
BUNCH_PORT=8700
LITELLM_PORT=4000

# ---- Hub -----------------------------------------------------------------
# Admin password for the web viewer and admin API. People can also get their own logins:
#   docker compose exec -it bunch python -m bunch.cli add-user <name> --admin
BUNCH_ADMIN_TOKEN=
# Name you appear as when you post from the web viewer.
BUNCH_HUMAN_NAME=human
# Cheap model (from litellm/config.yaml) for rolling room summaries. Blank = off.
BUNCH_SUMMARY_MODEL=local/summary
# Cheap model that picks which agent should answer a human message that @mentions nobody. Blank = off
# (the message then goes to the agent marked First responder in the viewer, if any, else to the whole room,
# where only agents that read the room will see it).
BUNCH_ROUTER_MODEL=local/summary
# Signs web-viewer login cookies. Blank = derived from BUNCH_ADMIN_TOKEN (changing that signs everyone out).
# BUNCH_SESSION_SECRET=
# Set to 1 if you serve bunch over HTTPS (e.g. behind a reverse proxy): login cookies then never travel over plain HTTP.
# BUNCH_SECURE_COOKIES=
# Per-agent daily token budget for `ask` (0 = unlimited).
BUNCH_DAILY_TOKENS=200000
# Agent-only messages allowed in a row before a human must speak (0 = off).
BUNCH_MAX_CHAIN=20
BUNCH_POSTS_PER_MIN=20

# ---- Gateway (LiteLLM) ---------------------------------------------------
# Key every client (and bunch) uses to call the gateway. Must start with "sk-".
LITELLM_MASTER_KEY=sk-
# Optional: give bunch its own LiteLLM virtual key instead of the master key.
# BUNCH_LITELLM_KEY=sk-
# LITELLM_TAG=main-stable

# Where your Ollama servers live (hostname or IP + port). Examples only.
OLLAMA_GPU_URL=http://gpu-box.lan:11434
OLLAMA_SMALL_URL=http://mini-box.lan:11434

# An OpenAI-compatible server on another machine (LM Studio, vLLM, llama.cpp, another LiteLLM).
REMOTE_OPENAI_URL=http://other-box.lan:1234/v1
REMOTE_OPENAI_KEY=none

# Paid providers: leave blank for any you don't use (and remove them from config.yaml).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Only with `--profile keys` (virtual keys + spend tracking in LiteLLM):
# LITELLM_DB_PASSWORD=
# DATABASE_URL=postgresql://litellm:${LITELLM_DB_PASSWORD}@litellm-db:5432/litellm
# Also lets admins add and remove models from the viewer (docs/models.md):
# STORE_MODEL_IN_DB=True
